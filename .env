# --- Application ---
APP_NAME=Samarth
APP_ENV=development         # development | production
DEBUG=true
LOG_LEVEL=info

# --- Server ---
HOST=0.0.0.0
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# --- MongoDB (Required) ---
# Get your free Atlas URI from: https://cloud.mongodb.com
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGO_URI=mongodb+srv://samarthiitbhu_db_user:samsam%40101@samarth.teliz2u.mongodb.net/?appName=Samarth
MONGO_DB_NAME=samarth

# --- Authentication ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=e704bfe9cb88165a5bdf4aad930bab2305cf68992622a029399f0cb12ad07f5a58d4ffe9dd388fefeb52683b7755464bb114512949406c86fb090714341b918b
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Storage ---
# STORAGE_BACKEND: local (dev) or cloudinary (production)
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads

# Cloudinary (only needed when STORAGE_BACKEND=cloudinary)
CLOUDINARY_CLOUD_NAME=dorg0vdaa
CLOUDINARY_API_KEY=167669159341662
CLOUDINARY_API_SECRET=SD80Hl6GNZ4XjMcnmiygvzhofeA

# --- PS1 Pipeline ---
# Absolute path to the pipeline/ folder (PS1 module)
PS1_PIPELINE_PATH=../pipeline
PS1_STRIDE=2
PS1_ENHANCE=true
PS1_ENHANCE_LEVEL=auto
PS1_SAVE_ANNOTATED_VIDEO=false

# --- PS2 Exercise Analysis (Future — leave blank until PS2 is ready) ---
# When PS2 model is ready: set this to the model weights path
# The system auto-switches from mock to real analyzer when this is set
PS2_MODEL_PATH=../rehabnet_best.pth
PS2_USE_REAL_MODEL=true

# --- PS3 Sensor Hub (Future — leave blank until PS3 is ready) ---
PS3_SENSOR_PORT=
PS3_USE_REAL_SENSOR=false
PS3_BAUD_RATE=115200

# --- Email / Notifications (Optional) ---
